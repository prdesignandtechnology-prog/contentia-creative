---
const { url, title = "Schedule a call" } = Astro.props;
---
<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
  <p class="text-sm font-semibold text-slate-700">{title}</p>
  <iframe
    class="mt-4 h-[520px] w-full rounded-xl border border-slate-200"
    src={`${url}?hide_event_type_details=1&hide_gdpr_banner=1`}
    title="Calendly scheduling"
  ></iframe>
</div>
