---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../content/settings/site.json";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---
<BaseLayout title={`Insights | ${site.brand_name}`} description="Articles on AI content, SEO, and automation.">
  <section class="py-16">
    <div class="container">
      <p class="section-kicker">Insights</p>
      <h1 class="section-title mt-2">Growth insights, delivered weekly.</h1>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {posts.map((post) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6" key={post.slug}>
            <h2 class="font-display text-lg">{post.data.title}</h2>
            <p class="mt-2 text-sm text-slate-600">{post.data.description}</p>
            <p class="mt-2 text-xs text-slate-500">Published {post.data.publishDate}</p>
            <a class="mt-4 inline-flex text-sm font-semibold text-cc-teal" href={`/blog/${post.slug}`}>
              Read article →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
