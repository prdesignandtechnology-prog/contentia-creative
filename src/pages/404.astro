---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import site from "../content/settings/site.json";
---
<BaseLayout title={`Page Not Found | ${site.brand_name}`} description="Page not found.">
  <section class="py-24">
    <div class="container text-center">
      <h1 class="font-display text-4xl">Page not found</h1>
      <p class="mt-4 text-slate-600">The page you’re looking for doesn’t exist yet.</p>
      <div class="mt-6">
        <CTA href="/" label="Back to home" />
      </div>
    </div>
  </section>
</BaseLayout>
