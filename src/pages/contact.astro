---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import site from "../content/settings/site.json";
---
<BaseLayout title={`Contact | ${site.brand_name}`} description="Talk to our team about your growth goals.">
  <section class="bg-slate-50 py-16">
    <div class="container grid gap-10 md:grid-cols-2">
      <div>
        <p class="section-kicker">Contact</p>
        <h1 class="section-title mt-2">Let’s build your growth plan.</h1>
        <p class="mt-4 text-slate-600">
          Tell us about your goals and we’ll follow up with a tailored plan.
        </p>
        <div class="mt-6 space-y-2 text-sm text-slate-600">
          <p><strong>Phone:</strong> {site.phone}</p>
          <p><strong>Email:</strong> {site.email}</p>
          <p><strong>Service Area:</strong> {site.service_area}</p>
        </div>
        <div class="mt-6">
          <CTA href={site.calendly_url} label={site.cta_label} />
        </div>
      </div>
      <form
        class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
        method="POST"
        action="/.netlify/functions/lead"
      >
        <input type="hidden" name="bot-field" value="" />
        <div class="grid gap-4">
          <label class="text-sm font-semibold text-slate-700">
            Name
            <input class="mt-1 w-full rounded-md border border-slate-200 p-2" type="text" name="name" required />
          </label>
          <label class="text-sm font-semibold text-slate-700">
            Email
            <input class="mt-1 w-full rounded-md border border-slate-200 p-2" type="email" name="email" required />
          </label>
          <label class="text-sm font-semibold text-slate-700">
            Phone
            <input class="mt-1 w-full rounded-md border border-slate-200 p-2" type="tel" name="phone" />
          </label>
          <label class="text-sm font-semibold text-slate-700">
            Company
            <input class="mt-1 w-full rounded-md border border-slate-200 p-2" type="text" name="company" />
          </label>
          <label class="text-sm font-semibold text-slate-700">
            Message
            <textarea class="mt-1 w-full rounded-md border border-slate-200 p-2" name="message" rows="4" required></textarea>
          </label>
        </div>
        <button class="mt-6 w-full rounded-full bg-cc-teal py-2 text-sm font-semibold text-white" type="submit">
          Submit inquiry
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
