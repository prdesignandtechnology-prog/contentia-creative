---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import SchemaOrganization from "../components/SchemaOrganization.astro";
import site from "../content/settings/site.json";
import { getCollection } from "astro:content";

const services = await getCollection("services");
const caseStudies = await getCollection("caseStudies");
const featuredCaseStudies = caseStudies.slice(0, 3);
---
<BaseLayout title={`${site.brand_name} | ${site.tagline}`} description={site.tagline}>
  <SchemaOrganization />
  <section class="bg-gradient-to-br from-white via-white to-cc-purple/30">
    <div class="container grid gap-10 py-20 md:grid-cols-2 md:items-center">
      <div>
        <p class="section-kicker">AI-Powered Creative Agency</p>
        <h1 class="mt-3 font-display text-4xl leading-tight md:text-5xl">
          {site.tagline}
        </h1>
        <p class="mt-4 text-lg text-slate-600">
          We help growth-focused teams scale content, capture local demand, and automate revenue workflows.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <CTA href={site.calendly_url} label={site.cta_label} />
          <CTA href="/contact" label="Request a Proposal" variant="secondary" />
        </div>
      </div>
      <div class="rounded-3xl border border-cc-purple/40 bg-white p-6 shadow-lg">
        <p class="text-sm font-semibold text-slate-700">Trusted Outcomes</p>
        <ul class="mt-4 space-y-3 text-sm text-slate-600">
          <li>✅ 2x organic traffic in 90 days</li>
          <li>✅ 75% increase in inbound calls</li>
          <li>✅ 60% faster reporting workflows</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <p class="section-kicker">Services</p>
      <h2 class="section-title mt-2">Everything you need to get found and convert.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {services.map((service) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" key={service.slug}>
            <h3 class="font-display text-xl">{service.data.title}</h3>
            <p class="mt-3 text-sm text-slate-600">{service.data.summary}</p>
            <div class="mt-4">
              <CTA href={`/services/${service.slug}`} label="Learn more" variant="secondary" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="container">
      <p class="section-kicker">Case Studies</p>
      <h2 class="section-title mt-2">Proven results across industries.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {featuredCaseStudies.map((study) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6" key={study.slug}>
            <h3 class="font-display text-lg">{study.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{study.data.summary}</p>
            <ul class="mt-3 space-y-1 text-xs text-slate-500">
              {study.data.results.slice(0, 2).map((result) => (
                <li>{result}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container rounded-3xl bg-cc-dark px-8 py-12 text-white md:px-12">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="font-display text-3xl">Ready to grow smarter?</h2>
          <p class="mt-2 max-w-xl text-sm text-slate-200">
            Book a strategy call and get a tailored roadmap for your content, SEO, and automation goals.
          </p>
        </div>
        <CTA href={site.calendly_url} label={site.cta_label} />
      </div>
    </div>
  </section>
</BaseLayout>
