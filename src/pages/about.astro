---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/settings/site.json";
---
<BaseLayout title={`About | ${site.brand_name}`} description="Learn about our approach and mission.">
  <section class="py-16">
    <div class="container">
      <p class="section-kicker">About</p>
      <h1 class="section-title mt-2">Built for teams who want to move faster.</h1>
      <p class="mt-4 max-w-3xl text-slate-600">
        Contentia Creative blends strategy, AI, and creative execution to help growth teams build durable
        demand. We focus on clarity, quality, and automation so your marketing engine stays consistent.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="font-display text-lg">Mission</h2>
          <p class="mt-2 text-sm text-slate-600">Deliver content and automation that convert into revenue.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="font-display text-lg">Difference</h2>
          <p class="mt-2 text-sm text-slate-600">We pair AI systems with human expertise for reliability.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="font-display text-lg">Approach</h2>
          <p class="mt-2 text-sm text-slate-600">Strategy first, automation second, continuous optimization.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
