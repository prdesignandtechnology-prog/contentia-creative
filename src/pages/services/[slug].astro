---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import SchemaService from "../../components/SchemaService.astro";
import SchemaFAQ from "../../components/SchemaFAQ.astro";
import site from "../../content/settings/site.json";
import { getCollection, getEntryBySlug } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const { slug } = Astro.params;
const service = await getEntryBySlug("services", slug);
if (!service) throw new Error("Service not found");
const { data } = service;
const { Content } = await service.render();
---
<BaseLayout title={`${data.title} | ${site.brand_name}`} description={data.summary}>
  <SchemaService serviceName={data.title} description={data.summary} />
  <SchemaFAQ faqs={data.faqs} />
  <section class="bg-gradient-to-br from-white to-cc-purple/30 py-16">
    <div class="container">
      <p class="section-kicker">Service</p>
      <h1 class="section-title mt-2">{data.title}</h1>
      <p class="mt-4 max-w-2xl text-slate-600">{data.hero}</p>
      <div class="mt-6">
        <CTA href={site.calendly_url} label={site.cta_label} />
      </div>
    </div>
  </section>
  <section class="py-16">
    <div class="container grid gap-10 md:grid-cols-2">
      <div>
        <p class="section-kicker">Outcome</p>
        <h2 class="section-title mt-2">{data.outcome}</h2>
        <div class="prose prose-slate mt-4 max-w-none">
          <Content />
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-slate-700">Deliverables</p>
        <ul class="mt-4 list-disc space-y-2 pl-4 text-sm text-slate-600">
          {data.deliverables.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="bg-slate-50 py-16">
    <div class="container">
      <p class="section-kicker">Process</p>
      <div class="mt-8 grid gap-6 md:grid-cols-4">
        {data.process.map((step, index) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5" key={step.title}>
            <p class="text-xs font-semibold text-cc-teal">Step {index + 1}</p>
            <h3 class="mt-2 font-display text-lg">{step.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="section-kicker">FAQs</p>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {data.faqs.map((faq) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5" key={faq.question}>
            <h3 class="font-semibold text-slate-800">{faq.question}</h3>
            <p class="mt-2 text-sm text-slate-600">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
