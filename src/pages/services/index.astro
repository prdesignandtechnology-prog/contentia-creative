---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import site from "../../content/settings/site.json";
import { getCollection } from "astro:content";

const services = await getCollection("services");
---
<BaseLayout title={`Services | ${site.brand_name}`} description="Explore our AI-powered services.">
  <section class="bg-slate-50 py-16">
    <div class="container">
      <p class="section-kicker">Services</p>
      <h1 class="section-title mt-2">Solutions built for modern growth teams.</h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Each service is designed to help you scale visibility, improve conversions, and automate the work
        that slows your team down.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {services.map((service) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6" key={service.slug}>
            <h2 class="font-display text-xl">{service.data.title}</h2>
            <p class="mt-3 text-sm text-slate-600">{service.data.summary}</p>
            <div class="mt-4">
              <CTA href={`/services/${service.slug}`} label="View service" variant="secondary" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
